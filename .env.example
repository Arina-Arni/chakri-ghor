# Copy to .env.local and fill in. Never commit real values.

# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# The anon / publishable key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for Storage signed URLs and admin auth operations.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Settings → Database → Connection string
# App traffic through the pooler (transaction mode, port 6543)
DATABASE_URL=
# Migrations through the direct connection (port 5432)
DIRECT_URL=

# Public URL of the app, e.g. http://localhost:3000 or https://chakri-radar.vercel.app
APP_URL=
# Random string (32+ chars) used to hash IP addresses; never store raw IPs
IP_HASH_SALT=

# ── Part 3 ──
# Google Gemini (server only). Without it every AI feature uses its fallback.
GEMINI_API_KEY=
# A fast "Flash" model, e.g. gemini-3.5-flash (gemini-2.5-flash is closed to new keys)
GEMINI_MODEL=
# Optional: comma-separated backup models used when GEMINI_MODEL's (free) quota runs out.
# Default: gemini-3.5-flash-lite. Free-tier limits are counted per model.
GEMINI_FALLBACK_MODELS=
# Resend (email). Without it emails stay queued; in-app notifications still work.
RESEND_API_KEY=
# e.g. Chakri Radar <noreply@your-domain>
EMAIL_FROM=
# Random string (32+ chars); pg_cron sends it to /api/cron/*
CRON_SECRET=
# "true" lets admins inject AI faults into THEIR OWN requests (judges' demo)
FAULT_INJECTION_ALLOWED=
PAYMENT_PROVIDER=mock
# Random string (32+ chars) used to sign mock payment webhooks
PAYMENT_WEBHOOK_SECRET=
# Optional: extra comma-separated hosts allowed for PDF-URL ingest
INGEST_ALLOWED_HOSTS=
