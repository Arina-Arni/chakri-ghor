# Copy to .env.local and fill in. Never commit real values.

# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# The anon / publishable key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for Storage signed URLs and admin auth operations.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Settings → Database → Connection string
# App traffic through the pooler (transaction mode, port 6543)
DATABASE_URL=
# Migrations through the direct connection (port 5432)
DIRECT_URL=

# Public URL of the app, e.g. http://localhost:3000 or https://chakri-radar.vercel.app
APP_URL=
# Random string (32+ chars) used to hash IP addresses; never store raw IPs
IP_HASH_SALT=
